{
  "metadata": {
    "nome": "Alvará Funcionamento Salvador",
    "sigla": "PREF_SALVADOR",
    "versao": "2.0",
    "autor": "api-sefaz-ssa",
    "dataCriacao": "2026-08-10",
    "dataUltimaValidacao": "2026-10-05",
    "urlOficial": "https://servicosweb.sefaz.salvador.ba.gov.br/WebsiteV2/Sistemas/AlvaraCgaInternet/Modulos/Principal/AlvaraCgaEmissaoFrm.aspx?opEmissao=A",
    "descricao": "Emissão do Alvará de Funcionamento (CGA) da SEFAZ Salvador por CNPJ e inscrição municipal, com download do PDF oficial e extração do texto por OCR local"
  },
  "human": {
    "perfil": "normal"
  },
  "recursos": {
    "bloquearTipos": ["font", "media"],
    "bloquearHosts": ["google-analytics.com", "googletagmanager.com", "googleadservices.com", "doubleclick.net", "hotjar.com", "clarity.ms", "facebook.net", "mixpanel.com"]
  },
  "navegacao": {
    "url": "https://servicosweb.sefaz.salvador.ba.gov.br/WebsiteV2/Sistemas/AlvaraCgaInternet/Modulos/Principal/AlvaraCgaEmissaoFrm.aspx?opEmissao=A",
    "timeout": 30000,
    "waitUntil": "domcontentloaded"
  },
  "seletores": {
    "campo_cnpj": {
      "descricao": "Campo do CNPJ no formulário de emissão do alvará",
      "seletores": [
        "#ctl00_ContentPlaceHolderPrincipal_txtNuCnpj",
        "input[name*='txtNuCnpj']",
        "xpath=//input[contains(@id, 'txtNuCnpj')]"
      ]
    },
    "campo_cga": {
      "descricao": "Campo da inscrição municipal (CGA) no formulário de emissão do alvará",
      "seletores": [
        "#ctl00_ContentPlaceHolderPrincipal_txtNuCGA",
        "input[name*='txtNuCGA']",
        "xpath=//input[contains(@id, 'txtNuCGA')]"
      ]
    },
    "campo_cpf": {
      "descricao": "Campo do CPF do representante no formulário de emissão do alvará",
      "seletores": [
        "#ctl00_ContentPlaceHolderPrincipal_txtNuCpfRepresentante",
        "input[name*='txtNuCpf']",
        "xpath=//input[contains(@id, 'txtNuCpfRepresentante')]"
      ]
    },
    "botao_consultar": {
      "descricao": "Botão que submete a consulta e dispara o download do PDF oficial",
      "seletores": [
        "#ctl00_ContentPlaceHolderPrincipal_BtnConsultar0",
        "input[value='Consultar']",
        "xpath=//input[contains(@id, 'BtnConsultar')]"
      ]
    },
    "botao_confirmar": {
      "descricao": "Botão de confirmação do modal de emissão do novo alvará",
      "seletores": [
        "#ctl00_ContentPlaceHolderPrincipal_pnlMsgAlvara_btnConfirmar",
        "text=Confirmar",
        "xpath=//input[contains(@id, 'btnConfirmar')]"
      ]
    },
    "mensagem_erro": {
      "descricao": "Texto de validação do portal quando o alvará não é encontrado",
      "seletores": [
        "#ctl00_mspMensagem",
        "#ctl00_updMensagemErro",
        "xpath=//span[contains(@id, 'mspMensagem')]"
      ]
    }
  },
  "steps": [
    {
      "id": "navegar-portal",
      "descricao": "Abre a página de emissão do alvará de funcionamento",
      "acao": "navegar"
    },
    {
      "id": "preencher-cnpj",
      "descricao": "Preenche o campo de CNPJ",
      "acao": "preencher",
      "chaveSeletor": "campo_cnpj"
    },
    {
      "id": "preencher-cga",
      "descricao": "Preenche a inscrição municipal (CGA)",
      "acao": "preencher",
      "chaveSeletor": "campo_cga"
    },
    {
      "id": "preencher-cpf",
      "descricao": "Preenche o CPF do representante quando informado",
      "acao": "preencher",
      "chaveSeletor": "campo_cpf"
    },
    {
      "id": "submeter-consulta",
      "descricao": "Clica em Consultar",
      "acao": "clicar",
      "chaveSeletor": "botao_consultar"
    },
    {
      "id": "aguardar-download",
      "descricao": "Aguarda o download do PDF oficial ou a mensagem de erro do portal",
      "acao": "capturar-download"
    },
    {
      "id": "extrair-dados",
      "descricao": "Extrai o texto do PDF oficial pela porta OCR e converte em dados",
      "acao": "avaliar"
    },
    {
      "id": "gerar-artefatos",
      "descricao": "Registra o PDF oficial e gera print após a extração",
      "acao": "capturar-download"
    }
  ],
  "extracao": {
    "estrategia": "pdf-ocr",
    "descricao": "Download do PDF oficial seguido de extração do texto pela porta OCR (Fase 5 pluga pdfjs e tesseract); linhas no formato ROTULO: valor convertidas em campos; imune a re-layout enquanto os identificadores ASP.NET forem mantidos",
    "obrigatorio": ["razaoSocial"]
  },
  "artefatos": {
    "ordem": "apos-extracao",
    "print": { "formato": "jpeg", "qualidade": 70, "paginaInteira": true },
    "pdf": { "formato": "A4", "fundo": true }
  },
  "captcha": { "exigido": false }
}
