# Servidor
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Chave administrativa: cria/revoga API keys de usuarios (/v1/admin/apikeys)
ADMIN_KEY=troque-por-uma-chave-longa-e-aleatoria

# Chave de criptografia das sessoes de navegador (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Sessoes de navegador (storageState) persistidas em disco
SESSION_TTL_HORAS=12

# Concorrencia
# Numero maximo de automacoes simultaneas (ajustar conforme RAM: 4-6 para 8 GB)
SEMAFORO_GLOBAL=5
# Execucoes simultaneas por portal (1 = fila FIFO por portal)
SEMAFORO_POR_PORTAL=1

# Cache de resultados (ver src/config/cache.ts)
# Formato: 7d | 12h | 45m | 30s  (por tipo de automacao)
# Exemplos de override:
# CACHE_SEFAZ_BAHIA=14d
# CACHE_DAM_TFF_TLL=24h
# CACHE_DAM_TLL=24h

# Armazenamento
DATABASE_PATH=./data/app.sqlite
STORAGE_DIR=./storage

# Fila
# Tempo maximo (segundos) que uma execucao pode aguardar na fila antes de responder 503
FILA_TIMEOUT_SEG=90

# Higiene (limpeza periodica de cache expirado e documentos antigos)
HIGIENE_INTERVALO_MIN=60
DOCUMENTOS_TTL_DIAS=7
