{
  "name": "api-sefaz-ssa",
  "version": "0.1.0",
  "description": "API de automacoes de consulta em portais da SEFAZ Bahia e da Prefeitura de Salvador",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "browser:install": "playwright-core install chromium-headless-shell"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@napi-rs/canvas": "^1.0.10",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^9.13.0",
    "playwright-core": "^1.63.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
